# Porta em que o servidor Nuxt/Nitro vai escutar quando buildado (npm run build && node .output/server/index.mjs)
PORT=3000

# Host (0.0.0.0 para aceitar conexões externas, útil em produção/containers)
HOST=0.0.0.0

# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase Auth cuida da autenticação (email + senha). Os dados de negócio
# (pacientes, processos, pagamentos, chaves PIX) ficam em tabelas Postgres do MESMO
# projeto Supabase, acessadas só server-side com a service role key abaixo (sem RLS — o
# controle de acesso é na camada de API). Os anexos das prestações ficam no Supabase
# Storage (bucket privado "attachments", ver supabase/migrations/). A produção roda
# na Vercel: nada de negócio pode depender de arquivo local.

# Expostas ao client (bundle do browser) — projeto > Settings > API
NUXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Privada — NUNCA exposta ao client. Usada só no server: criar contas da equipe
# (server/api/admin/users.post.ts), acessar o Postgres e gerar as signed URLs dos
# anexos (server/utils/attachmentStorage.ts).
NUXT_SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# E-mails com permissão de admin, separados por vírgula.
NUXT_ADMIN_EMAILS=admin@farmaurora.com.br
